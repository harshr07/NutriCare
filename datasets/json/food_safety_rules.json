  "nutrient_rules": [
    {"disease": "type2_diabetes", "nutrient": "carbs", "unit": "g", "status": "TRACK", "message": "Track carbohydrates in the amount consumed. Use an individualized carbohydrate target.", "source": "ICMR"},
