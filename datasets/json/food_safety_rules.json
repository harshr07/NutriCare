    {"disease": "cardiovascular_disease", "ingredient_key": "partially_hydrogenated_oils", "status": "AVOID", "message": "Partially hydrogenated oil detected. This is an industrial trans-fat concern.", "source": "WHO_TRANS_FAT"},
    {"disease": "cardiovascular_disease", "ingredient_key": "saturated_fat_sources", "status": "LIMIT", "message": "This ingredient may contribute saturated fat. Check the actual nutrition value.", "source": "AHA_SAT_FAT"}
